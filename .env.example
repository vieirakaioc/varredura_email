# ------------------------------------------------------------------ servidor
PORT=3000
PUBLIC_URL=http://localhost:3000
# Segredo usado para cifrar os tokens OAuth e assinar o "state" do OAuth.
# Gere um valor aleatório longo (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# e NUNCA o altere depois de conectar as caixas (os tokens salvos ficariam ilegíveis).
APP_SECRET=
DATA_DIR=data
SESSAO_HORAS=12
# Administrador criado automaticamente no primeiro start (se não houver usuários)
ADMIN_EMAIL=admin@validador.local
ADMIN_SENHA=

# ------------------------------------------------------------------ captura de e-mails
CAPTURA_AUTOMATICA=true
CAPTURA_INTERVALO_MIN=10
CAPTURA_DIAS_RETROATIVOS=30
CAIXAS_EMAIL=suprimentos@grupocomelli.com.br,suprimentos@comber.com.br

# Zoho Mail (os dois domínios usam Zoho: MX mx.zoho.com)
# api-console.zoho.com > Server-based Application > Redirect URI = ${PUBLIC_URL}/api/oauth/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Data center da conta Zoho (.com, .eu, .in, .com.au...). Contas brasileiras normalmente usam .com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_API_URL=https://mail.zoho.com

# Alternativa: IMAP somente leitura com senha de aplicativo (nunca gravada no banco)
IMAP_HOST=imap.zoho.com
IMAP_PORT=993
# IMAP_SUPRIMENTOS_GRUPOCOMELLI_COM_BR_SENHA=
# IMAP_SUPRIMENTOS_COMBER_COM_BR_SENHA=

# Pasta local de importação (subpasta por caixa: <pasta>/<email>/*.eml|xml|pdf|zip)
# PASTA_IMPORTACAO=importacao

# ------------------------------------------------------------------ IA (opcional)
# Sem chave, o sistema funciona normalmente sem a camada de IA.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5

# ------------------------------------------------------------------ Senior (conciliação das notas de entrada)
# Usuário SOMENTE LEITURA no banco do Senior. Deixe em branco para desativar.
SENIOR_DB_TIPO=
SENIOR_DB_HOST=
SENIOR_DB_PORTA=
SENIOR_DB_NOME=
SENIOR_DB_USUARIO=
SENIOR_DB_SENHA=
# Janela de conferência (dias) e consulta alternativa (opcional, mantendo os aliases da consulta padrão)
SENIOR_DIAS=180
# SENIOR_SQL=
